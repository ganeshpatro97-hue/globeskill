# =========================================================================
# GlobeSkill Local Environment Variables Template (.env.local.example)
# Rename or copy this file to '.env.local' in your project root directory.
# NEVER commit your actual '.env.local' file containing real secrets to Git.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Supabase Connection Settings (Required)
# Find these in: Supabase Dashboard -> Project Settings -> API
# -------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-api-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# -------------------------------------------------------------------------
# 2. AI Learning Assistant Configuration (Required for AI Chatbot)
# Get a free API key from: Google AI Studio (https://aistudio.google.com)
# -------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# -------------------------------------------------------------------------
# 3. Payment Gateway Configuration (Required for Donor System)
# Get test API keys from: Stripe Dashboard -> Developers -> API Keys
# -------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_secret_stripe_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here

# Razorpay (Optional Alternative)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# -------------------------------------------------------------------------
# 4. Email Service Provider (Required for Automated Tax Receipts)
# Get an API key from: Resend Dashboard (https://resend.com)
# -------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
NO_REPLY_EMAIL=noreply@yourdomain.org

# -------------------------------------------------------------------------
# 5. Application URL Configurations (Required for Route Redirects)
# Used for local testing and CORS / auth callbacks
# -------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
